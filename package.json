{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "jest",
    "generate:city1": "NUXT_PUBLIC_CITY='city1' NUXT_PUBLIC_LANG='ru' nuxt generate",
    "generate:city1-en": "NUXT_PUBLIC_CITY='city1' NUXT_PUBLIC_LANG='en' nuxt generate",
    "generate:city2": "NUXT_PUBLIC_CITY='city2' NUXT_PUBLIC_LANG='ru' nuxt generate",
    "generate:city2-en": "NUXT_PUBLIC_CITY='city2' NUXT_PUBLIC_LANG='en' nuxt generate",
    "generate:all": "npm run generate:city1 && npm run generate:city1-en && npm run generate:city2 && npm run generate:city2-en",
    "build:city1": "NUXT_PUBLIC_CITY='city1' NUXT_PUBLIC_LANG='ru' nuxt build",
    "build:city1-en": "NUXT_PUBLIC_CITY='city1' NUXT_PUBLIC_LANG='en' nuxt build",
    "build:city2": "NUXT_PUBLIC_CITY='city2' NUXT_PUBLIC_LANG='ru' nuxt build",
    "build:city2-en": "NUXT_PUBLIC_CITY='city2' NUXT_PUBLIC_LANG='en' nuxt build",
    "build:all": "npm run build:city1 && npm run build:city1-en && npm run build:city2 && npm run build:city2-en"
    
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.2.1",
    "nuxt": "^3.14.1592",
    "vue": "latest",
    "vue-router": "latest",
    "vue3-carousel": "^0.15.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "jest": "^30.0.5",
    "sass": "^1.83.0",
    "vue-i18n": "^11.2.2"
  }
}
